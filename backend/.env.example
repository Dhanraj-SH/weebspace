NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=use-a-different-secret-with-at-least-32-characters
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=none
# Optional when frontend and API use subdomains of the same custom domain, e.g. .example.com.
# Leave unset for Vercel + Render default domains and use COOKIE_SAME_SITE=none.
COOKIE_DOMAIN=

# Optional Google OAuth. In Render, set the callback URL to the service's public URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Optional initial admin promotion (the account must already exist).
ADMIN_EMAIL=

# Optional Cloudflare R2 uploads. Configure all five required R2 values together.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
